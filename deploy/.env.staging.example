DB_NAME=pdv
DB_USER=pdv
DB_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=https://staging.example.com
PROXY_HTTP_PORT=80
DJANGO_ALLOWED_HOSTS=staging.example.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com
NUXT_PUBLIC_API_BASE=https://staging.example.com
NUXT_PUBLIC_APP_NAME=PDV Final Staging
DEFAULT_FROM_EMAIL=no-reply@staging.example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
ABACATEPAY_API_KEY=replace-with-abacatepay-sandbox-key
ABACATEPAY_API_BASE_URL=https://api.abacatepay.com/v2
ABACATEPAY_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
ABACATEPAY_ALLOW_SIMULATION=True
