DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
TRUST_X_FORWARDED_FOR=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_NAME=sessionid
SESSION_COOKIE_PATH=/
ADMIN_SESSION_COOKIE_NAME=admin_sessionid
ADMIN_SESSION_COOKIE_PATH=/admin/
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin

DB_NAME=pdv
DB_USER=pdv
DB_PASSWORD=pdv
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0

ABACATEPAY_API_KEY=replace-with-abacatepay-sandbox-key
ABACATEPAY_API_BASE_URL=https://api.abacatepay.com/v2
ABACATEPAY_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
ABACATEPAY_ALLOW_SIMULATION=True
BILLING_GRACE_PERIOD_DAYS=7
BILLING_DUE_SOON_DAYS=7
BILLING_SUSPENSION_WARNING_DAYS=2
